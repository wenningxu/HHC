  "schema": "hhc_online_wandb_training_policy_v1",
  "status": "active",
  "effective_from": "2026-08-31",
  "scope": "all newly launched training experiments",
  "mode": "online",
  "historical_runs_are_not_relabelled": true,
  "logging_interval_optimizer_steps": 50,
  "parameter_scope": "all trainable parameters",
  "norm_aggregation": "global L2 in float32 plus global maximum absolute value",
  "major_module_norm_effective_from": "2026-09-02",
  "major_module_norm_policy": "at every telemetry event, also log L2, maximum absolute value, gradient-to-weight L2 ratio, value counts, and non-finite counts for each trainable top-level child module under train/modules/<name>/; global metrics remain authoritative for all trainable parameters",
  "gradient_measurement_point": "after backward and AMP unscale, before gradient clipping and optimizer step",
  "weight_measurement_point": "at the same telemetry event, before optimizer step",
  "gradient_clipping_observability": "when clipping is enabled, also log the post-clip global L2 norm, configured clip threshold, and whether the telemetry event triggered clipping; derive the clip-hit rate over the run",
  "training_progress_axis": "explicit train/optimizer_step preferred, otherwise Lightning trainer/global_step; W&B _step is forbidden as optimizer progress",
  "validation_coverage_policy": "every required validation stream must have a finite event at or after the final required training-metric event",
  "nonfinite_policy": "log counts and fail closed",
